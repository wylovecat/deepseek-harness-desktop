{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "appearance-effects",
  "description": "Allows local shell windows to update native window backdrop effects.",
  "local": true,
  "windows": [
    "main",
    "remote-*",
    "window-*"
  ],
  "permissions": [
    "electron-window:allow-set-effects"
  ],
  "platforms": [
    "windows",
    "macOS"
  ]
}
